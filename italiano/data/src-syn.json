ro / costoso","def":"che ha un prezzo elevato"},{"w":"interessante","cefr":"B1","sentence":"Ho letto un articolo molto interessante sul clima.","syn":"avvincente","distractors":["noioso","banale","insignificante"],"es":"interesante","def":"che cattura l'attenzione"},{"w":"vecchio","cefr":"B1","sentence":"Abita in un palazzo molto vecchio del centro.","syn":"antico","distractors":["nuovo","moderno","recente"],"es":"viejo / antiguo","def":"di molti anni fa"},{"w":"forte","cefr":"B1","sentence":"Mio fratello è molto forte e fa palestra.","syn":"robusto","distractors":["debole","fragile","gracile"],"es":"fuerte","def":"dotato di grande forza fisica"},{"w":"allegro","cefr":"B1","sentence":"È sempre allegro e fa ridere tutti.","syn":"gioioso","distractors":["cupo","triste","malinconico"],"es":"alegre","def":"pieno di allegria"},{"w":"buono","cefr":"B1","sentence":"Questo dolce è davvero buono.","syn":"gustoso","distractors":["cattivo","insipido","amaro"],"es":"bueno / sabroso","def":"piacevole al gusto"},{"w":"freddo","cefr":"B1","sentence":"Stamattina fa molto freddo fuori.","syn":"gelido","distractors":["caldo","tiepido","afoso"],"es":"frío","def":"a bassa temperatura"},{"w":"pericolosa","cefr":"B1","sentence":"Quella strada di montagna è molto pericolosa.","syn":"rischiosa","distractors":["sicura","tranquilla","protetta"],"es":"peligroso","def":"che comporta dei rischi"},{"w":"ricco","cefr":"B1","sentence":"È un uomo molto ricco con tante proprietà.","syn":"benestante","distractors":["povero","misero","squattrinato"],"es":"rico","def":"che possiede molti beni"},{"w":"povera","cefr":"B1","sentence":"Da bambino la sua famiglia era molto povera.","syn":"indigente","distractors":["ricca","benestante","facoltosa"],"es":"pobre","def":"che ha pochi mezzi economici"},{"w":"corti","cefr":"B1","sentence":"Ha deciso di portare i capelli più corti.","syn":"brevi","distractors":["lunghi","estesi","ampi"],"es":"corto","def":"di poca lunghezza"},{"w":"lungo","cefr":"B1","sentence":"I