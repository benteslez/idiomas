[{"w":"il burro","cefr":"A1","real":"la mantequilla","trap":"el burro (animal)","d1":"el barro","d2":"la manteca de cerdo","note":"'burro' significa 'mantequilla'. El burro (animal) se dice 'asino' o 'somaro'."},{"w":"salire","cefr":"A1","real":"subir","trap":"salir","d1":"saludar","d2":"saltar","note":"'salire' significa 'subir'. 'Salir' se dice 'uscire'."},{"w":"subire","cefr":"B1","real":"sufrir / padecer","trap":"subir","d1":"subrayar","d2":"sobrar","note":"'subire' significa 'sufrir/soportar'. 'Subir' se dice 'salire'."},{"w":"uscire","cefr":"A1","real":"salir","trap":"usar","d1":"unir","d2":"escurrir","note":"'uscire' significa 'salir'. 'Usar' se dice 'usare'."},{"w":"caldo","cefr":"A1","real":"caliente / calor","trap":"caldo (sopa)","d1":"cálido","d2":"escaldado","note":"'caldo' significa 'caliente'. El caldo (sopa) se dice 'brodo'."},{"w":"il brodo","cefr":"A2","real":"el caldo","trap":"el bordo","d1":"el brote","d2":"el barro","note":"'brodo' significa 'caldo'. El 'bordo' se dice 'bordo' u 'orlo'."},{"w":"largo","cefr":"A1","real":"ancho","trap":"largo","d1":"holgado","d2":"vasto","note":"'largo' significa 'ancho'. 'Largo' se dice 'lungo'."},{"w":"lungo","cefr":"A1","real":"largo","trap":"lungo (de café)","d1":"lejano","d2":"alargado","note":"'lungo' significa 'largo'. 'Lungo' como punto cardinal no aplica; es simplemente 'largo'."},{"w":"guardare","cefr":"A1","real":"mirar","trap":"guardar","d1":"vigilar","d2":"cuidar","note":"'guardare' significa 'mirar'. 'Guardar' se dice 'conservare' o 'tenere'."},{"w":"l'aceto","cefr":"A2","real":"el vinagre","trap":"el aceite","d1":"la aceituna","d2":"el ácido","note":"'aceto' significa 'vinagre'. El 'aceite' se dice 'olio'."},{"w":"l'olio","cefr":"A1","real":"el aceite","trap":"el óleo","d1":"el oloroso","d2":"el ungüento","note":"'olio' significa 'aceite'. El 'óleo' (pintura) también es 'olio', pero el riesgo es confundirlo con 'aceto'."},{"w":"l'esito","cefr":"B1","real":"el resultado / desenlace","trap":"el éxito","d1":"el éxodo","d2":"la salida","note":"'esito' significa 'resultado'. El 'éxito' se dice 'successo'."},{"w":"il successo","cefr":"A2","real":"el éxito","trap":"el suceso","d1":"el sucesor","d2":"la sucesión","note":"'successo' significa 'éxito'. El 'suceso' se dice 'avvenimento' o 'fatto'."},{"w":"prima","cefr":"A1","real":"antes","trap":"prima (familiar)","d1":"primera","d2":"prima (de seguro)","note":"'prima' significa 'antes'. La 'prima' (familiar) se dice 'cugina'."},{"w":"pronto","cefr":"A1","real":"listo / ¿diga? (al teléfono)","trap":"pronto","d1":"rápido","d2":"temprano","note":"'pronto' significa 'listo'. 'Pronto' (en seguida) se dice 'presto' o 'subito'."},{"w":"il topo","cefr":"A2","real":"el ratón","trap":"el topo (animal)","d1":"el tope","d2":"el lunar (estampado)","note":"'topo' significa 'ratón'. El 'topo' (animal) se dice 'talpa'."},{"w":"la gamba","cefr":"A1","real":"la pierna","trap":"la gamba (marisco)","d1":"el gambito","d2":"la gama","note":"'gamba' significa 'pierna'. La 'gamba' (langostino) se dice 'gambero'."},{"w":"il vaso","cefr":"A2","real":"el jarrón / la maceta","trap":"el vaso","d1":"el vasallo","d2":"la vasija","note":"'vaso' significa 'jarrón/maceta'. El 'vaso' (para beber) se dice 'bicchiere'."},{"w":"il tovagliolo","cefr":"A2","real":"la servilleta","trap":"el toallón / toalla","d1":"el mantel","d2":"el paño","note":"'tovagliolo' significa 'servilleta'. La 'toalla' se dice 'asciugamano'."},{"w":"il mantello","cefr":"B1","real":"la capa / el manto","trap":"el mantel","d1":"la mantilla","d2":"la manta","note":"'mantello' significa 'capa'. El 'mantel' se dice 'tovaglia'."},{"w":"la fattoria","cefr":"B1","real":"la granja","trap":"la factoría / fábrica","d1":"la factura","d2":"el factor","note":"'fattoria' significa 'granja'. La 'fábrica' se dice 'fabbrica'."},{"w":"il camino","cefr":"A2","real":"la chimenea","trap":"el camino","d1":"el camión","d2":"la caminata","note":"'camino' significa 'chimenea'. El 'camino' se dice 'strada', 'via' o 'cammino'."},{"w":"la salita","cefr":"A2","real":"la cuesta / subida","trap":"la salida","d1":"la salina","d2":"la sala","note":"'salita' significa 'subida/cuesta'. La 'salida' se dice 'uscita'."},{"w":"l'uscita","cefr":"A1","real":"la salida","trap":"la usura","d1":"la unión","d2":"la oscilación","note":"'uscita' significa 'salida'. No confundir con 'salita' (subida)."},{"w":"nudo","cefr":"A2","real":"desnudo","trap":"nudo","d1":"crudo","d2":"mudo","note":"'nudo' significa 'desnudo'. El 'nudo' se dice 'nodo'."},{"w":"il nodo","cefr":"B1","real":"el nudo","trap":"el nodo (informático)","d1":"el codo","d2":"el modo","note":"'nodo' significa 'nudo'. 'Desnudo' se dice 'nudo'."},{"w":"primo","cefr":"A1","real":"primero","trap":"primo (familiar)","d1":"primor","d2":"primario","note":"'primo' significa 'primero'. El 'primo' (familiar) se dice 'cugino'."},{"w":"il ratto","cefr":"B1","real":"la rata","trap":"el rato","d1":"el rapto","d2":"la racha","note":"'ratto' significa 'rata'. Un 'rato' (de tiempo) se dice 'un po'' o 'un momento'."},{"w":"l'oso","cefr":"B2","real":"el hueso (de fruta) / atrevimiento","trap":"el oso","d1":"el oído","d2":"el ocio","note":"'osso' significa 'hueso'; 'oso' es del verbo 'osare' (atreverse). El 'oso' (animal) se dice 'orso'."},{"w":"lasciare","cefr":"A2","real":"dejar","trap":"lanzar","d1":"lavar","d2":"largar","note":"'lasciare' significa 'dejar'. 'Lanzar' se dice 'lanciare'."},{"w":"seguire","cefr":"A2","real":"seguir","trap":"asegurar","d1":"perseguir","d2":"segar","note":"'seguire' significa 'seguir'. 'Asegurar' se dice 'assicurare'."},{"w":"sembrare","cefr":"A2","real":"parecer","trap":"sembrar","d1":"temblar","d2":"sumergir","note":"'sembrare' significa 'parecer'. 'Sembrar' se dice 'seminare'."},{"w":"l'imbarazzo","cefr":"B1","real":"la vergüenza / apuro","trap":"el embarazo","d1":"el embarque","d2":"el barullo","note":"'imbarazzo' significa 'vergüenza'. El 'embarazo' se dice 'gravidanza'."},{"w":"il negozio","cefr":"A1","real":"la tienda","trap":"el negocio","d1":"el negociado","d2":"la negociación","note":"'negozio' significa 'tienda'. El 'negocio' se dice 'affare'."},{"w":"la ditta","cefr":"B1","real":"la empresa","trap":"la dicta / dictado","d1":"la cita","d2":"el dato","note":"'ditta' significa 'empresa'. El 'dictado' se dice 'dettato'."},{"w":"l'autista","cefr":"B1","real":"el conductor / chófer","trap":"el autista","d1":"el artista","d2":"el automovilista","note":"'autista' significa 'conductor'. El 'autista' (condición) se dice 'autistico'."},{"w":"la cantina","cefr":"A2","real":"la bodega / el sótano","trap":"la cantina (bar)","d1":"la cantimplora","d2":"la cancha","note":"'cantina' significa 'bodega/sótano'. La 'cantina' (comedor) se dice 'mensa'."},{"w":"la stanza","cefr":"A2","real":"la habitación","trap":"la estancia","d1":"la instancia","d2":"el estanque","note":"'stanza' significa 'habitación'. La 'estancia' (período) se dice 'soggiorno'."},{"w":"il soggiorno","cefr":"A2","real":"el salón / la estancia","trap":"el sojuzgamiento","d1":"el sojo","d2":"la sujeción","note":"'soggiorno' significa 'salón' o 'estancia (período)'. No tiene relación con sujetar."},{"w":"la salsa","cefr":"A2","real":"la salsa (de cocina)","trap":"la salsa (baile)","d1":"el salseo","d2":"el aderezo","note":"'salsa' significa 'salsa de cocina'. La 'salsa' (baile/música) se dice también 'salsa', pero el sentido habitual es culinario."},{"w":"il pavimento","cefr":"A2","real":"el suelo / piso","trap":"el pavimento (de calle)","d1":"el pabellón","d2":"el pavés","note":"'pavimento' significa 'suelo' (interior). El 'pavimento' de calle se dice 'manto stradale'."},{"w":"la tavola","cefr":"A1","real":"la mesa / tabla","trap":"la tabla (lista)","d1":"el tablón","d2":"la taberna","note":"'tavola' significa 'mesa'. La 'tabla' de datos se dice 'tabella'."},{"w":"caro","cefr":"A1","real":"caro / querido","trap":"carro","d1":"cara","d2":"claro","note":"'caro' significa 'caro' o 'querido'. El 'carro' se dice 'carro' o 'auto', pero ojo: 'caro' no es 'carro'."},{"w":"la carta","cefr":"A1","real":"el papel","trap":"la carta (misiva)","d1":"el cartel","d2":"la cartera","note":"'carta' significa 'papel'. La 'carta' (misiva) se dice 'lettera'."},{"w":"la lettera","cefr":"A1","real":"la carta / la letra","trap":"la litera","d1":"el lector","d2":"la lectura","note":"'lettera' significa 'carta' o 'letra'. La 'litera' se dice 'cuccetta'."},{"w":"il burro di arachidi","cefr":"B1","real":"la mantequilla de cacahuete","trap":"el burro de cacahuete","d1":"la pasta de maní","d2":"la crema de frutos secos","note":"'burro' sigue significando 'mantequilla'. Nada que ver con el animal."},{"w":"l'aula","cefr":"A2","real":"el aula","trap":"la jaula","d1":"el aula magna","d2":"la sala","note":"'aula' significa 'aula'. La 'jaula' se dice 'gabbia'."},{"w":"la gabbia","cefr":"B1","real":"la jaula","trap":"la gavia / gabia","d1":"la cabina","d2":"la cabaña","note":"'gabbia' significa 'jaula'. No confundir con 'gavia'."},{"w":"il pane","cefr":"A1","real":"el pan","trap":"el paño","d1":"el panel","d2":"la pana","note":"'pane' significa 'pan'. El 'paño' se dice 'panno'."},{"w":"il panno","cefr":"B1","real":"el paño / trapo","trap":"el pan","d1":"el panel","d2":"el pañal","note":"'panno' significa 'paño'. El 'pan' se dice 'pane'."},{"w":"la pila","cefr":"B1","real":"la pila / montón","trap":"la pila (de agua)","d1":"la píldora","d2":"el pilar","note":"'pila' significa 'pila' o 'montón'. Como sentido habitual incluye 'batería', no la pila bautismal."},{"w":"la firma","cefr":"A2","real":"la firma (rúbrica)","trap":"la firma (empresa)","d1":"el firmamento","d2":"lo firme","note":"'firma' significa 'rúbrica'. La 'firma/empresa' se dice 'ditta' o 'azienda'."},{"w":"il palazzo","cefr":"A2","real":"el edificio","trap":"el palacio","d1":"el palco","d2":"el paladar","note":"'palazzo' significa 'edificio'. El 'palacio' real se dice 'reggia' o también 'palazzo' según contexto."},{"w":"la villa","cefr":"A2","real":"el chalé / casa de campo","trap":"la villa (pueblo)","d1":"el villano","d2":"la villanía","note":"'villa' significa 'chalé'. La 'villa/pueblo' se dice 'paese' o 'cittadina'."},{"w":"il paese","cefr":"A1","real":"el país / pueblo","trap":"el peso","d1":"el paisaje","d2":"el campesino","note":"'paese' significa 'país' o 'pueblo'. El 'peso' se dice 'peso'."},{"w":"l'osso","cefr":"A2","real":"el hueso","trap":"el oso","d1":"el oído","d2":"el ojo","note":"'osso' significa 'hueso'. El 'oso' (animal) se dice 'orso'."},{"w":"il piatto","cefr":"A1","real":"el plato","trap":"el pato","d1":"la pita","d2":"el pacto","note":"'piatto' significa 'plato'. El 'pato' se dice 'anatra' o 'papero'."},{"w":"l'anatra","cefr":"B1","real":"el pato","trap":"la nata","d1":"la anatomía","d2":"el ánade","note":"'anatra' significa 'pato'. La 'nata' se dice 'panna'."},{"w":"la panna","cefr":"A2","real":"la nata","trap":"el paño / la pana","d1":"el pan","d2":"la pana (tela)","note":"'panna' significa 'nata'. La 'pana' (tela) se dice 'velluto a coste'."},{"w":"il prosciutto","cefr":"A2","real":"el jamón","trap":"el prosciutto crudo solamente","d1":"el chorizo","d2":"el embutido","note":"'prosciutto' significa 'jamón' en general. No es un tipo concreto exclusivo."},{"w":"l'ufficio","cefr":"A1","real":"la oficina","trap":"el oficio","d1":"el oficial","d2":"el edificio","note":"'ufficio' significa 'oficina'. El 'oficio' (profesión) se dice 'mestiere'."},{"w":"il mestiere","cefr":"B1","real":"el oficio / profesión","trap":"el menester","d1":"el ministerio","d2":"el maestro","note":"'mestiere' significa 'oficio'. 'Menester' como necesidad se dice 'bisogno'."},{"w":"la lente","cefr":"B1","real":"la lente","trap":"lento","d1":"la lenteja","d2":"el lente de contacto solamente","note":"'lente' significa 'lente'. 'Lento' se dice 'lento'. La lenteja se dice 'lenticchia'."},{"w":"la lenticchia","cefr":"B2","real":"la lenteja","trap":"la lentilla / lente","d1":"la lentejuela","d2":"el lentisco","note":"'lenticchia' significa 'lenteja'. La 'lentilla' se dice 'lente a contatto'."},{"w":"la crepa","cefr":"B2","real":"la grieta","trap":"la crepe / crepa","d1":"la crema","d2":"la capa","note":"'crepa' significa 'grieta'. La 'crepe' (dulce) se dice 'crêpe' o 'crespella'."},{"w":"il prete","cefr":"B1","real":"el cura / sacerdote","trap":"el préstamo / prestar","d1":"el pretexto","d2":"el pretor","note":"'prete' significa 'cura'. 'Prestar' se dice 'prestare'."},{"w":"sentire","cefr":"A1","real":"oír / sentir / oler","trap":"sentarse","d1":"sentenciar","d2":"asentir","note":"'sentire' significa 'oír' o 'sentir'. 'Sentarse' se dice 'sedersi'."},{"w":"il sedere","cefr":"B1","real":"el trasero / sentarse (verbo)","trap":"el seder / ceder","d1":"la sede","d2":"el sedal","note":"'sedere' significa 'sentarse' o 'trasero'. 'Ceder' se dice 'cedere'."},{"w":"affollato","cefr":"B1","real":"abarrotado / concurrido","trap":"afollado","d1":"aflojado","d2":"afortunado","note":"'affollato' significa 'abarrotado'. La 'folla' es la multitud."},{"w":"la folla","cefr":"B1","real":"la multitud / muchedumbre","trap":"la folla / hoja","d1":"la falla","d2":"la olla","note":"'folla' significa 'multitud'. La 'olla' se dice 'pentola'."},{"w":"la pentola","cefr":"A2","real":"la olla","trap":"el péndulo","d1":"la pinta","d2":"la pendiente","note":"'pentola' significa 'olla'. No tiene relación con 'péndulo'."},{"w":"la posata","cefr":"B1","real":"el cubierto (de mesa)","trap":"la posada","d1":"la pausa","d2":"la posa","note":"'posata' significa 'cubierto'. La 'posada' se dice 'locanda'."},{"w":"la locanda","cefr":"B2","real":"la posada / fonda","trap":"la locanda no es loca","d1":"la loma","d2":"el local","note":"'locanda' significa 'posada'. El 'local' se dice 'locale'."},{"w":"il quadro","cefr":"A2","real":"el cuadro (pintura)","trap":"el cuadro (rectángulo) solamente","d1":"el cuaderno","d2":"el escuadrón","note":"'quadro' significa 'cuadro/pintura'. El 'cuadro' como figura geométrica es 'quadrato'."},{"w":"la cornice","cefr":"B1","real":"el marco","trap":"la cornisa","d1":"la corneta","d2":"el cuerno","note":"'cornice' significa 'marco'. La 'cornisa' se dice 'cornicione'."},{"w":"il burrone","cefr":"B2","real":"el barranco / precipicio","trap":"el burrón / burro grande","d1":"el borrón","d2":"el burdel","note":"'burrone' significa 'barranco'. No tiene relación con 'burro'."},{"w":"la cattura","cefr":"B1","real":"la captura","trap":"la cattura no es factura","d1":"la lectura","d2":"la criatura","note":"'cattura' significa 'captura'. Atención a no leerla como 'factura' ('fattura')."},{"w":"la fattura","cefr":"B1","real":"la factura","trap":"la hechura / hechizo","d1":"la fractura","d2":"la atadura","note":"'fattura' significa 'factura'. También puede significar 'hechizo', pero no 'fractura'."},{"w":"il bottone","cefr":"A2","real":"el botón","trap":"el botellón","d1":"el botín","d2":"el bidón","note":"'bottone' significa 'botón'. No confundir con otras palabras parecidas."},{"w":"l'equipaggio","cefr":"B1","real":"la tripulación","trap":"el equipaje","d1":"el equipo","d2":"el equipamiento","note":"'equipaggio' significa 'tripulación'. El 'equipaje' se dice 'bagaglio'."},{"w":"il bagaglio","cefr":"A2","real":"el equipaje","trap":"el bagaje (intelectual) solamente","d1":"el baúl","d2":"la baga","note":"'bagaglio' significa 'equipaje'. El 'bagaje' figurado coincide, pero el sentido habitual es maleta."},{"w":"la coppa","cefr":"B1","real":"la copa (trofeo) / embutido","trap":"la copa (de beber)","d1":"la copla","d2":"la capa","note":"'coppa' es 'copa-trofeo' o un embutido. La 'copa' de beber es 'coppa' también, pero ojo con 'bicchiere' para el vaso."},{"w":"la firma autografa","cefr":"B2","real":"la firma autógrafa","trap":"la firma de empresa","d1":"el autógrafo de famoso","d2":"el autorretrato","note":"'firma' es 'rúbrica'. La empresa es 'azienda/ditta'."},{"w":"contestare","cefr":"B2","real":"impugnar / rebatir","trap":"contestar","d1":"contextualizar","d2":"constatar","note":"'contestare' significa 'impugnar'. 'Contestar' (responder) se dice 'rispondere'."},{"w":"rispondere","cefr":"A1","real":"responder / contestar","trap":"resplandecer","d1":"reposar","d2":"corresponder","note":"'rispondere' significa 'responder'. No confundir con 'esconder' ('nascondere')."},{"w":"l'esposizione","cefr":"B1","real":"la exposición","trap":"la esposa / esposas","d1":"la exposición de motivos solamente","d2":"el esposo","note":"'esposizione' significa 'exposición'. La 'esposa' se dice 'moglie'."},{"w":"la moglie","cefr":"A2","real":"la esposa","trap":"la mole / molla","d1":"la migaja","d2":"la mosca","note":"'moglie' significa 'esposa'. No confundir con 'mole' (montaña/edificio)."},{"w":"il guanto","cefr":"A2","real":"el guante","trap":"cuánto / cuanto","d1":"el guiño","d2":"el gancho","note":"'guanto' significa 'guante'. 'Cuánto' se dice 'quanto'."},{"w":"la macchia","cefr":"B1","real":"la mancha","trap":"la macha / el macho","d1":"el matorral solamente","d2":"la maquia","note":"'macchia' significa 'mancha'. También 'monte bajo', pero el sentido frecuente es 'mancha'."},{"w":"il guasto","cefr":"B1","real":"la avería","trap":"el gusto","d1":"el gasto","d2":"lo gastado","note":"'guasto' significa 'avería' o 'estropeado'. El 'gusto' se dice 'gusto'."},{"w":"caldo arrosto","cefr":"B2","real":"asado caliente","trap":"caldo de arroz","d1":"caldo asado","d2":"sopa caliente","note":"'caldo' es 'caliente' y 'arrosto' es 'asado'. Nada que ver con el caldo-sopa ('brodo')."},{"w":"l'arrosto","cefr":"B1","real":"el asado","trap":"el arrastre / arrastro","d1":"el rostro","d2":"el arroz","note":"'arrosto' significa 'asado'. El 'arroz' se dice 'riso'."},{"w":"il riso","cefr":"A2","real":"el arroz / la risa","trap":"el riso / rizo","d1":"el riesgo","d2":"el queso","note":"'riso' significa 'arroz' o 'risa'. El 'rizo' se dice 'ricciolo'."},{"w":"il burro fuso","cefr":"B2","real":"la mantequilla derretida","trap":"el burro fusilado / fusión de burro","d1":"la manteca fundida de cerdo","d2":"el queso fundido","note":"'burro' es 'mantequilla' y 'fuso' es 'fundido'. Nada que ver con el animal."},{"w":"la noia","cefr":"B1","real":"el aburrimiento","trap":"la noya / novia","d1":"el ruido","d2":"la noche","note":"'noia' significa 'aburrimiento'. La 'novia' se dice 'fidanzata' o 'ragazza'."}]